{
	"schemaVersion": 1,
	"id": "ironjetpacks",
	"version": "${version}",
	"name": "Iron Jetpacks",
	"description": "A fully customizable energy-powered jetpacks mod.",
	"icon": "assets/ironjetpacks/icon.png",
	"authors": [
		"BlakeBr0",
		"Joni"
	],
	"contact": {
		"homepage": "https://blakesmods.com/iron-jetpacks",
		"sources": "https://github.com/BlakeBr0/IronJetpacks"
	},
	"license": "MIT",
	"environment": "*",
	"mixins": [
		"iron-jetpacks.mixins.json",
		{
			"config": "iron-jetpacks.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"main": [
			"com.blakebr0.ironjetpacks.IronJetpacks"
		],
		"client": [
			"com.blakebr0.ironjetpacks.client.IronJetpacksClient"
		],
		"jei_mod_plugin": [
			{
				"value": "com.blakebr0.ironjetpacks.client.compat.JeiCompat",
				"environment": "client"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"jei": "*"
	}
}